# ============================================================
# DEVSHARE PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production and update values
# ============================================================

# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Configuration
# Option 1: MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devshare?retryWrites=true&w=majority

# Option 2: Local MongoDB (Docker)
# MONGODB_URI=mongodb://admin:password@mongodb:27017/devshare?authSource=admin
MONGO_USER=admin
MONGO_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_long_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Service URLs
AI_SERVICE_URL=https://your-rag-service.com
CLIENT_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-backend-domain.com
RAG_URL=https://your-rag-service.com

# Frontend URLs (for VITE build)
VITE_API_URL=https://your-backend-domain.com
VITE_RAG_URL=https://your-rag-service.com

# Optional: External Services
SENTRY_DSN=https://your-sentry-dsn
LOG_LEVEL=info

# Optional: Third-party APIs
OPENROUTER_API_KEY=your_openrouter_key_if_using_cloud_llm

# Optional: Monitoring & Analytics
DATADOG_API_KEY=your_datadog_key
NEW_RELIC_LICENSE_KEY=your_newrelic_key

# ============================================================
# NOTES:
# - Use strong, random passwords for production
# - Never commit this file to version control
# - Use environment-specific secrets management
# - Rotate secrets regularly
# - Monitor for unauthorized access
# ============================================================
